# ─────────────────────────────────────────────────────────────
# FootMon environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Placeholder names only in this file — no real secrets.
# ─────────────────────────────────────────────────────────────

# ── Supabase: server-side (never exposed to the browser) ──
# Project REST URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Service role key (starts with `sb_secret_` or a JWT `eyJ...`).
# Full DB admin. Server-only. Do NOT use a publishable/anon key here.
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase: browser-side (safe to expose, RLS-protected) ──
# Used by the Realtime client in the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key (starts with `sb_publishable_` or a JWT `eyJ...`).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Duel resolver: server-held signer that calls resolveDuel() ──
# Server-only. MUST NOT be prefixed NEXT_PUBLIC_.
RESOLVER_PRIVATE_KEY=

# ── Duel session tokens ──
# HMAC secret (>= 32 chars) signing the per-room bearer tokens that authorise
# draft picks. Server-only. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Chain / deployment ──
# Monad Testnet RPC (chain id 10143)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Deployer key used only by forge scripts. Server-only.
DEPLOYER_PRIVATE_KEY=

# ── WalletConnect / Reown AppKit ──
# Get a free project ID at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
